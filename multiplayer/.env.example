# HTTPS frontend requires a WSS backend; never expose the native forge bridge.
VITE_GAME_WS_URL=wss://YOUR-GAME-SERVER/ws
# Gateway only; exact comma-separated HTTPS origins, no wildcard in production.
ALLOWED_ORIGINS=https://YOUR-GAME-SITE.vercel.app
GODOT_BIN=godot
WORLD_DATA_DIR=/data/worlds
PORT=8090
