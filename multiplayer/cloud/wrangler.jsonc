{
  "$schema": "https://unpkg.com/wrangler@4.147.0/config-schema.json",
  "name": "branns-forge-rooms",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "account_id": "90174ecc41dad8b7b9e2059887157566",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://branns-forge-multiplayer.vercel.app,http://127.0.0.1:5178,http://localhost:5178",
    "DISCONNECT_GRACE_MS": "15000",
    "OFFER_MS": "120000"
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ForgeRoom" }, { "name": "DIRECTORY", "class_name": "ForgeDirectory" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ForgeRoom"] }, { "tag": "v2", "new_sqlite_classes": ["ForgeDirectory"] }],
  "ratelimits": [{ "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 64, "period": 60 } }, { "name": "DIRECTORY_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
